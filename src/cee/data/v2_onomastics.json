  "toponym_paradigms": {
    "descriptive_terrain": {
      "description": "Přívlastkové místní jméno podle krajiny (např. Bílá Hora, Dlouhé Pole, Černá Řeka).",
      "head_pool": "terrain",
      "modifier_pool": "modifiers",
      "reduce_head": false
    },
    "habitative_formant": {
      "description": "Sídelní jméno se zkráceným formantem (-hrad/-burg/-ton/-ves).",
      "head_pool": "settlement",
      "modifier_pool": "heroic_first",
      "reduce_head": true
    },
    "hydro_crossing": {
      "description": "Říční brod, ústí nebo přístav (např. Oxford, Innsbruck, Rostock).",
      "head_pool": "crossing_heads",
      "modifier_pool": "hydro_heads",
      "reduce_head": false
    },
    "sacred_civic": {
      "description": "Posvátné, královské nebo tržní středisko (např. Králův Hrad, Boží Dar).",
      "head_pool": "urban_heads",
      "modifier_pool": "sacred_civic",
      "reduce_head": true
    },
    "eponymous_founder": {
      "description": "Sídlo pojmenované po zakladateli nebo rodu.",
      "head_pool": "settlement",
      "modifier_pool": "nature_stems",
      "reduce_head": true
    }
  },
  "anthroponym_paradigms": {
    "dithematic_ie": {
      "kind": "real_world",
      "label_cs": "Dvojčlenné rodové a patronymické (indoevropský / slovansko-germánský typ)",
      "slots": ["given_dithematic_or_hypocoristic", "patronymic_or_toponymic"]
    },
    "tria_nomina": {
      "kind": "real_world",
      "label_cs": "Tříčlenné občansko-rodové (antický / římský typ: praenomen + nomen + cognomen)",
      "slots": ["praenomen", "gentilic_nomen", "epithet_cognomen"]
    },
    "genealogical_nisba": {
      "kind": "real_world",
      "label_cs": "Genealogický řetězec s původem (semitský / ostrovní / stepní typ: jméno + syn X + z Y)",
      "slots": ["given_monothematic", "filiation", "nisba_toponym"]
    },
    "clan_generational": {
      "kind": "real_world",
      "label_cs": "Klanově-generační (východoasijský typ: klanový znak + generační slabika + osobní jméno)",
      "slots": ["clan_monosyllable", "generational_syllable", "given_monothematic"]
    },
    "liturgical_vernacular": {
      "kind": "real_world",
      "label_cs": "Diglosní kalendářní (adaptované jméno z liturgického/spisovného jazyka + domácí příjmení)",
      "slots": ["given_liturgical_adapted", "patronymic_or_toponymic"]
    },
    "caste_guild_matrix": {
      "kind": "fictional",
      "label_cs": "Kastovní a cechovní matice (živlová/cechovní předpona + osobní kmen + městský formant)",
      "slots": ["caste_prefix_given", "city_formant_surname"]
    },
    "chrononymic_deed": {
      "kind": "fictional",
      "label_cs": "Obřadní jméno činu (dětské přírodní jméno + dospělé jméno činu sloveso-předmět + dům)",
      "slots": ["deed_compound_given", "milk_name_byname", "house_lineage"]
    },
    "polyglossic_court": {
      "kind": "fictional",
      "label_cs": "Dvorská diglosie (vysoké dvorské jméno v úředním kódu + domácí krbové jméno)",
      "slots": ["high_court_name", "vernacular_hearth_name"]
    }
  }
